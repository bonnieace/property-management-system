NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_management
DATABASE_POOL_MAX=10
# Exact origin, with no path or trailing slash. HTTPS is required in production.
SITE_ORIGIN=http://localhost:4000
# Required to save merchant credentials. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Store the real value in your secret manager and back it up separately from the DB.
CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated trusted reverse-proxy CIDRs only; leave unset without a proxy.
TRUST_PROXY=
# Demo seeds are destructive fixtures, never production setup.
ALLOW_DEMO_SEED=false
# Optional one-time platform administrator; remove these after bootstrapping.
BOOTSTRAP_USERNAME=
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
