# ─── Safaricom Daraja Credentials ───────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke after creating an app
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Sandbox shortcode — use 174379 for sandbox, your real till/paybill for prod
MPESA_SHORTCODE=174379

# Sandbox passkey — Safaricom provides this in the Daraja portal
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Account reference shown on customer's M-Pesa SMS
MPESA_ACCOUNT_REF=NyathiraHomes

# Transaction description (shown in Daraja logs)
MPESA_TRANSACTION_DESC=Nyathira Homes Booking

# ─── Callback URL ────────────────────────────────────────────────────────────
# Must be publicly reachable by Safaricom. Use ngrok in development:
#   ngrok http 4000  →  copy the https URL and append /api/mpesa/callback
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/mpesa/callback

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Environment: "sandbox" or "production" ──────────────────────────────────
MPESA_ENV=sandbox

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Connection string format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nyathira_bookings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nyathira_bookings
DATABASE_USER=postgres
DATABASE_USER_PASSWORD=postgres
